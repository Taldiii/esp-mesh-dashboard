# Template. Copy to .env.local (gitignored) and put YOUR key there.
# Never put a real key in .env — that file is tracked by git.

MESH_TRANSPORT=serial
MESH_SERIAL_PORT=COM3
# MESH_TRANSPORT=tcp
MESH_HOST=192.168.1.100
MESH_PORT=8080
MESH_NODE_ID=node-001
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8000

# --- AI: DeepSeek V4.1 Flash via OpenCode Go ---
AI_PROVIDER=opencode-go
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=deepseek-v4.1-flash
AI_API_FORMAT=chat_completions
# The Go gateway rejects calls without a session id (opencode.ai/docs/go). Any UUID works.
AI_SESSION_ID=00000000-0000-0000-0000-000000000000
AI_USER_AGENT=esp-mesh-dashboard/1.0

# --- AI: free local fallback, no key needed ---
# ollama serve   &&   ollama pull gemma3:4b
# AI_PROVIDER=ollama
# AI_API_KEY=ollama-local
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=gemma3:4b
# AI_API_FORMAT=chat_completions

# --- Optional: friendly station names (raw id -> label) ---
# NODE_ALIASES={"AA:BB:CC:11:22:01": "Tentative 1", "AA:BB:CC:11:22:02": "Tentative 2", "AA:BB:CC:11:22:03": "Tentative 3"}
